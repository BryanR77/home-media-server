{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "hotio Whisparr v3 tags (v3-3.0.0.617)",
      "matchPackageNames": [
        "ghcr.io/hotio/whisparr"
      ],
      "versioning": "regex:^(?<compatibility>v3)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    }
  ]
}
